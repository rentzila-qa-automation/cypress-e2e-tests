{
  "name": "rentzila-cypress-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress E2E tests for Rentzila",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
